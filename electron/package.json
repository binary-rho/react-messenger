{
  "name": "react-messenger-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "react-messenger 웹을 감싼 맥 데스크톱 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.rho.reactmessenger",
    "productName": "Messenger",
    "files": ["main.js", "preload.js"],
    "mac": { "category": "public.app-category.social-networking", "target": ["dmg"] }
  }
}
